{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.hand": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "hand": "query.get_equipped_item_name == 'hand'" },
				{ "hand_empty": "query.get_equipped_item_name == 'hand_empty'" }
			  ],
			  "on_entry": [
				"@s js:no_gun"
			  ]
			},
			"hand": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'hand'" }
			  ],
			  "on_entry": [
			  ]
			},
			"hand_empty": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'hand_empty'" }
			  ],
			  "on_entry": [
			  ]
			}
		  }
		}
	}
}