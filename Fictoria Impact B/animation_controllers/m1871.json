{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.m1871": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "m1871": "query.get_equipped_item_name == 'm1871'" },
				{ "m1871_empty": "query.get_equipped_item_name == 'm1871_empty'" }
			  ],
			  "on_entry": [
				"@s js:no_gun"
			  ]
			},
			"m1871": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'm1871'" }
			  ],
			  "on_entry": [
			  ]
			},
			"m1871_empty": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'm1871_empty'" }
			  ],
			  "on_entry": [
			  ]
			}
		  }
		}
	}
}