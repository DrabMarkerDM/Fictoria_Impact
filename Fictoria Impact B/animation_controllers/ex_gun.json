{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ex_gun": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "ex_gun": "query.get_equipped_item_name == 'ex_gun'" },
				{ "ex_gun_empty": "query.get_equipped_item_name == 'ex_gun_empty'" }
			  ],
			  "on_entry": [
				"@s js:no_gun"
			  ]
			},
			"ex_gun": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'ex_gun'" }
			  ],
			  "on_entry": [
			  ]
			},
			"ex_gun_empty": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'ex_gun_empty'" }
			  ],
			  "on_entry": [
			  ]
			}
		  }
		}
	}
}