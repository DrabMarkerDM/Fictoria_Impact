{"format_version":"1.8.0",
"animation_controllers":{
"controller.animation.dm0skill":{
"states":{
"default":{"transitions":[
{"attack":"variable.attack_time > 0.0 && query.variant != 5 "}

]

},
"attack": {
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0 || query.variant == 5 "
						}
					],
"on_entry": [
"/scoreboard players add @s dm_skill_timer 1",
"/event entity @s[scores={dm_skill_timer=55..}] sss",
"/scoreboard players set @s[scores={dm_skill_timer=55..}] dm_skill_timer 0"
]
}
}
}
}
}