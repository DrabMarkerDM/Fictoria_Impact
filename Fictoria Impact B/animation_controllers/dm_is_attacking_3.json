{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dm_is_attacking_3": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "attacking": "query.property('dm:is_attacking_3') == 'on'" }
          ]
        },
        "attacking": {
          "animations": [ "skill_timer" ],
          "transitions": [
            { "idle": "query.property('dm:is_attacking_3') == 'off'" }
          ]
        }
      }
    }
  }
}