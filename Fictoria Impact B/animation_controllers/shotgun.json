{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.shotgun": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "shotgun": "query.get_equipped_item_name == 'shotgun'" },
				{ "shotgun_empty": "query.get_equipped_item_name == 'shotgun_empty'" }
			  ],
			  "on_entry": [
				"@s js:no_gun"
			  ]
			},
			"shotgun": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'shotgun'" }
			  ],
			  "on_entry": [
			  ]
			},
			"shotgun_empty": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'shotgun_empty'" }
			  ],
			  "on_entry": [
			  ]
			}
		  }
		}
	}
}