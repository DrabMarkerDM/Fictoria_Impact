{"format_version":"1.8.0",
	"animation_controllers": {
		"controller.animation.dm62_equip": {
			"states": {
				"default": {
					"transitions": [
						{ "att": "query.is_powered && variable.has_target" }

					]

				},
				"att": {
					"transitions": [
						{
							"default": "!query.is_powered || !variable.has_target"
						}
					],
					"on_entry": [
						"@s attack_1"
					]
				}
			}
		}
	}
}