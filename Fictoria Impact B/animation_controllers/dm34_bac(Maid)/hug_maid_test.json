{"format_version":"1.8.0",
	"animation_controllers": {
		"controller.animation.hug_maid_test": {
			"states": {
				"default": {
					"transitions": [
						{ "att": "query.variant == 1 && !query.is_riding" }

					]

				},
				"att": {
					"transitions": [
						{
							"default": "query.variant != 1 || query.is_riding"
						}
					],
					"on_entry": [
						"@s die"
					]
				}
			}
		}
	}
}