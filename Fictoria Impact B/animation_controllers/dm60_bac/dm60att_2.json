{"format_version":"1.8.0",
	"animation_controllers": {
		"controller.animation.dm60att_2": {
			"states": {
				"default": {
					"transitions": [
						{ "attack": "query.is_delayed_attacking && query.variant == 2 " }

					]

				},
				"attack": {
					"transitions": [
						{
							"default": "!query.is_delayed_attacking || query.variant != 2 "
						}
					],
					"on_entry": [
						"/particle dm:dm60_att_2 ^ ^2 ^2",
						"/damage @e[tag=!dm,family=monster,r=4,c=3] 53 magic entity @s",
						"/scoreboard players add @s dm60_2 1",
						"/scoreboard players add @s dm60 1",
						"/event entity @e[scores={dm60_2=2..}] switch_1",
						"/event entity @e[scores={dm60=21..}] sss",
						"/scoreboard players set @e[scores={dm60_2=2..}] dm60_2 0",
						"/scoreboard players set @e[scores={dm60=21..}] dm60 0",
						"/effect @s absorption 2 2 true",
						"/scoreboard players add @e[type=player:dm33,r=16] dm33 1"
					]
				}
			}
		}
	}
}