{"format_version":"1.8.0",
	"animation_controllers": {
		"controller.animation.dm60att_3": {
			"states": {
				"default": {
					"transitions": [
						{ "attack": "variable.attack_time > 0.0 && query.variant == 3 " }

					]

				},
				"attack": {
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0 || query.variant != 3 "
						}
					],
					"on_entry": [
						"/particle dm:dm60_att_3 ^ ^2 ^2",
						"/damage @e[tag=!dm,family=monster,r=12] 143 magic entity @s",
						"/function dm60_1",
						"/scoreboard players add @s dm_skill_timer_6 1",
						"/event entity @s[scores={dm_skill_timer_6=1..}] back",
						"/scoreboard players set @s[scores={dm_skill_timer_6=1..}] dm_skill_timer_6 0",
						"/scoreboard players set @s[scores={dm_skill_timer_2=..-5}] dm_skill_timer_2 -4",
						"/scoreboard players set @s[scores={dm_skill_timer_6=..-7}] dm_skill_timer_6 -6",
						"/scoreboard players add @e[type=player:dm33,r=16] dm_skill_timer 1"

					]
				}
			}
		}
	}
}