{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ak47": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "ak47": "query.get_equipped_item_name == 'ak47'" },
				{ "ak47_empty": "query.get_equipped_item_name == 'ak47_empty'" }
			  ],
			  "on_entry": [
				"@s js:no_gun"
			  ]
			},
			"ak47": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'ak47'" }
			  ],
			  "on_entry": [
			  ]
			},
			"ak47_empty": {
			  "transitions": [
				{ "default": "query.get_equipped_item_name != 'ak47_empty'" }
			  ],
			  "on_entry": [
			  ]
			}
		  }
		}
	}
}