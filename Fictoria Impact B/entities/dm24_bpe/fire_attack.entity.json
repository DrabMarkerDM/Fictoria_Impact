                "num_to_spawn": 1
              }
            ],
		"minecraft:timer": {
		  "looping": true,
		  "randomInterval": false,
		  "time": 0.14,
		  "time_down_event": {
		    "event": "minecraft:start_despawn"
		  }
            },

            "minecraft:despawn": {
                "filters": {
                    "all_of": [{
