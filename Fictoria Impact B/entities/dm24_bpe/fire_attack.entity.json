        "family": [ "bullet", "inanimate", "dm" ]
      },
      "minecraft:collision_box": {
        "width": 0.24,
        "height": 0.24
      },
			"minecraft:spawn_entity": [
              {
                "min_wait_time": 0,
                "max_wait_time": 0,
                "single_use": true,
                "spawn_entity": "null:null",
