{
	"format_version": "1.12.0",
	"minecraft:entity": {
		"description": {
	"identifier": "bullet:mon3tr_ex",
			"runtime_identifier": "minecraft:snowball",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"minecraft:exploding": {
				"minecraft:explode": {
					"fuseLength": 0,
					"fuseLit": true,
					"power": 4.1,
					"causesFire": true,
					"destroyAffectedByGriefing": true
				}
            },
            "despawning": {
                "minecraft:type_family": {
                    "family": ["despawer", "despawer_despawning", "dm"
                    ]
                }
            }
		},
		"components": {
			"minecraft:type_family": {
				"family": ["bullet","inanimate", "dm" ]
			},
			"minecraft:collision_box": {
				"width": 0.12,
				"height": 0.12
			},
		"minecraft:timer": {
		  "looping": true,
		  "randomInterval": false,
		  "time": 0.25,
		  "time_down_event": {
		    "event": "minecraft:start_despawn"
		  }
         },
            "minecraft:despawn": {
                "filters": {
                    "all_of": [{
                            "any_of": [{
                                    "test":
                                    "is_family",
                                    "subject": "self",
                                    "value": "despawer_despawning"
                                }
                            ]
                        }
                    ]
                }
            },
			"minecraft:projectile": {
				"onHit": {
					"impact_damage": {
						"damage": 1,
						"knockback": true,
						"semirandomdiffdamage": false,
						"destroyonhit": false
					},
					"definition_event": {
						"affectProjectile": true,
						"eventTrigger": {
							"event": "minecraft:explode",
							"target": "self"
						}
					}
				},
				"power": 3.8,
				"gravity": 0.01,
				"inertia": 1.8,
				"liquid_inertia": 1.8,
				"anchor": 1,
				"catchFire": true
			},
			"minecraft:physics": {}
		},
		"events": {
			"minecraft:explode": {
				"add": {
					"component_groups": [
						"minecraft:exploding"
					]
				}
			},
            "minecraft:start_despawn": {
                "add": {
                    "component_groups": ["despawning"]
                }
            }
        }
    }
}
