{
  "format_version": "1.12.0",
 "minecraft:entity": {
  "description": {
    "identifier": "bullet:dm35_bullet",
    "is_spawnable": false,
    "is_summonable": true,
    "runtime_identifier": "minecraft:snowball",
    "is_experimental": false,
    "scripts": {
      "animate": [
        "fire",
        "light",
        "bow"
      ]
    },
    "animations": {
      "fire": "controller.animation.firearrow",
      "bow": "controller.animation.dm35bow",
      "light": "controller.animation.light_1"
    }
  },
        "component_groups": {
            "t1": {
        "minecraft:variant": {
		  "value": 1 
                 }
            },
           "t2": {
        "minecraft:variant": {
		  "value": 2 
                 }
            },
            "minecraft:exploding": {
                "minecraft:explode": {
                    "fuseLength": 0,
                    "fuseLit": true,
                    "power": 1.3,
                    "causesFire": true,
                    "fire_affected_by_griefing": true,
                    "destroy_affected_by_griefing": true
                }
            },
            "despawning": {
                "minecraft:type_family": {
                    "family": ["despawer", "despawer_despawning", "dm"
                    ]
                }
            }
  },
  "components": {
    "minecraft:type_family": {
      "family": [ "bullet", "inanimate", "dm" ]
    },
    "minecraft:collision_box": {
      "width": 0.21,
      "height": 0.21
    },
    "minecraft:timer": {
      "looping": true,
      "randomInterval": false,
      "time": 0.2,
      "time_down_event": {
        "event": "minecraft:start_despawn"
      }
    },
    "minecraft:spawn_entity": [
      {
        "min_wait_time": 0,
        "max_wait_time": 0,
        "single_use": true,
        "spawn_entity": "null:null",
        "spawn_sound": "fire",
        "num_to_spawn": 1
      }
    ],
    "minecraft:despawn": {
      "filters": {
        "all_of": [
          {
            "any_of": [
              {
                "test": "is_family",
                "subject": "self",
                "value": "despawer_despawning"
              }
            ]
          }
        ]
      }
    },
    "minecraft:projectile": {

      "on_hit": {
        "impact_damage": {
          "damage": 23,
          "knockback": true,
          "catch_fire": true,
          "semirandomdiffdamage": false,
          "destroyonhit": false
        },
        "definition_event": {
          "affectProjectile": true,
          "eventTrigger": {
            "event": "random",
            "target": "self"
          },
          "catch_fire": {
            "fire_affected_by_griefing": true
          }
        }
      },
      "power": 2.1,
      "hit_sound": "bow.hit",
      "gravity": 0.02,
      "inertia": 5,
      "should_bounce": true,
      "liquid_inertia": 3,
      "anchor": 1,
      "uncertainty_base": 1,
      "uncertainty_multiplier": 0,
      "offset": [ 0, -0.4, 0 ],
      "semi_random_diff_damage": false,
      "reflect_on_hurt": true
    },
    "minecraft:physics": {
    },
    "minecraft:pushable": {
      "is_pushable": true,
      "is_pushable_by_piston": true
    }
  },
    "events": {
       "minecraft:entity_spawned": {
         "add": {
          "component_groups": [
            "t1"
          ]
        }
       },
            "minecraft:explode": {
                "add": {
                    "component_groups": ["minecraft:exploding"]
                }
            },
            "minecraft:start_despawn": {
                "add": {
                    "component_groups": ["despawning"]
                }
      },
                "random": {
       "randomize": [
                       {
            "weight": 40,
            "add":{"component_groups":["t2"]
}

          }

        ]
      }

    }
  }
}
