{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bullet:dm48_s_ak_bullet",
      "runtime_identifier": "minecraft:snowball",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuseLength": 0,
          "fuseLit": true,
          "power": 0.2,
          "causesFire": false,
          "fire_affected_by_griefing": true,
          "destroy_affected_by_griefing": true
        }
      },
      "despawning": {
        "minecraft:type_family": {
          "family": [ "despawer", "despawer_despawning", "dm" ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "bullet", "inanimate", "dm" ]
      },
      "minecraft:collision_box": {
        "width": 0.28,
        "height": 0.28
      },
      "minecraft:timer": {
        "looping": false,
        "randomInterval": false,
        "time": 0.25,
        "time_down_event": {
          "event": "minecraft:start_despawn"
        }
      },
            "minecraft:despawn": {
                "filters": {
                    "all_of": [{
                            "any_of": [{
                                    "test":
                                    "is_family",
                                    "subject": "self",
                                    "value": "despawer_despawning"
                                }
                            ]
                        }
                    ]
                }
      },
      "minecraft:projectile": {
        "onHit": {
          "impact_damage": {
            "damage": 33,
            "knockback": true,
            "semirandomdiffdamage": false,
            "destroyonhit": true
          }
        },
        "hit_sound": "gun.hit",
        "liquid_inertia": 1,
        "power": 1,
        "gravity": 0,
        "uncertaintyBase": 18,
        "uncertaintyMultiplier": 8,
        "angleoffset": 0.0,
        "reflect_on_hurt": true,
        "anchor": 1,
        "offset": [ 0, -0.1, 0 ],
        "inertia": 2
      },
      "minecraft:physics": {    
   }
    },
    "events": {
      "minecraft:explode": {
        "add": { "component_groups": [ "minecraft:exploding" ] 
        }
      },
      "minecraft:start_despawn": {
        "add": { "component_groups": [ "despawning" ] 
      }
                 },
        "minecraft:entity_spawned": {
          "queue_command": {
            "command": [
              "playsound dm.ak_shoot @a[r=33] ~~~ 2.8 1.3"
            ]
          }
            }
        }
    }
}