      "randomInterval": false,
      "time": 0.25,
      "time_down_event": {
        "event": "minecraft:start_despawn"
      }
    },
    "minecraft:spawn_entity": [
      {
        "min_wait_time": 0,
        "max_wait_time": 0,
        "single_use": true,
        "spawn_entity": "null:null",
        "spawn_sound": "fire",
        "num_to_spawn": 1
      }
    ],
    "minecraft:despawn": {
      "filters": {
        "all_of": [
          {
            "any_of": [
              {
                "test": "is_family",
                "subject": "self",
                "value": "despawer_despawning"
              }
            ]
          }
        ]
      }
    },
    "minecraft:projectile": {
      "on_hit": {
