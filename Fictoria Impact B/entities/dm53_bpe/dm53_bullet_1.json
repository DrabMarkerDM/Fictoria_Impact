{
  "format_version": "1.12.0",
 "minecraft:entity": {
  "description": {
    "identifier": "bullet:dm53_bullet_1",
    "is_spawnable": false,
    "is_summonable": true,
    "runtime_identifier": "minecraft:snowball",
    "is_experimental": false
  },
        "component_groups": {

            "despawning": {
                "minecraft:type_family": {
                    "family": ["despawer", "despawer_despawning", "dm"
                    ]
                }
            }
  },
  "components": {
