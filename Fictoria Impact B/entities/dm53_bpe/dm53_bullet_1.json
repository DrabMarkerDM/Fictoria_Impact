          "semirandomdiffdamage": false,
          "destroyonhit": false
        },
        "definition_event": {
          "affectProjectile": false,
          "eventTrigger": {
            "event": "hit",
            "target": "self"
          }
        }
      },
      "power": 2.6,
      "gravity": 0.00,
      "inertia": 1.8,
      "stop_on_hurt": false,
      "multiple_targets": true,
      "liquid_inertia": 1.8,
      "anchor": 1,
      "uncertainty_base": 24,
      "uncertainty_multiplier": 14,
      "offset": [ -0.5, 0.5, 5 ],
      "reflect_on_hurt": true
