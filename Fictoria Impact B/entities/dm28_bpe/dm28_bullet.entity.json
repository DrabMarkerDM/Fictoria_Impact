{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bullet:dm28_bullet",
      "runtime_identifier": "minecraft:snowball",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
        "component_groups": {
            "minecraft:exploding": {
                "minecraft:explode": {
                    "fuseLength": 0,
                    "fuseLit": true,
                    "power": 0.3,
                    "causesFire": false,
                    "fire_affected_by_griefing": true,
                    "destroy_affected_by_griefing": true
                }
            },
            "despawning": {
                "minecraft:type_family": {
                    "family": ["despawer", "despawer_despawning", "dm"
                    ]
                }
            }
    },
    "components": {
    "minecraft:type_family": {
        "family": [ "bullet", "inanimate", "dm" ]
      },
      "minecraft:collision_box": {
        "width": 0.21,
        "height": 0.21
      },
		"minecraft:timer": {
		  "looping": true,
		  "randomInterval": false,
		  "time": 0.25,
		  "time_down_event": {
		    "event": "minecraft:start_despawn"
		  }
            },
			"minecraft:spawn_entity": [
              {
                "min_wait_time": 0,
                "max_wait_time": 0,
                "single_use": true,
                "spawn_entity": "null:null",
                "spawn_sound": "fire",
                "num_to_spawn": 1
              }
            ],
            "minecraft:despawn": {
                "filters": {
                    "all_of": [{
                            "any_of": [{
                                    "test":
                                    "is_family",
                                    "subject": "self",
                                    "value": "despawer_despawning"
                                }
                            ]
                        }
                    ]
                }
      },
    "minecraft:projectile": {
	"onHit": {
	"impact_damage": {
    "damage": 20,
	"knockback": true,
	"semirandomdiffdamage": false,
	"destroyonhit": true
	},
        "mob_effect": {
          "effect": "slowness",
          "durationeasy": 40,
          "durationnormal": 40,
          "durationhard": 40,
          "amplifier": 2
          },
          "remove_on_hit": { 
          }
        },
         "hit_sound": "gun.hit",
        "liquid_inertia": 1,
        "power": 1,
        "gravity": 0,
     "uncertaintyBase": 20,
     "uncertaintyMultiplier": 10,
        "angleoffset": 0.0,
        "reflect_on_hurt": true,
        "anchor": 1,
        "offset": [ 0, -0.1, 0 ],
        "inertia": 2
      },
	    "minecraft:physics": {
	    }
        },
        "events": {
            "minecraft:explode": {
                "add": {
                    "component_groups": ["minecraft:exploding"]
                }
            },
            "minecraft:start_despawn": {
                "add": {
                    "component_groups": ["despawning"]
                }
            }
        }
    }
}