      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 0,
        "height": 0
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 0,
            "height": 0,
            "pivot": [ 0, -999, 0 ]
          }
        ]
      },
      "minecraft:physics": {
        "has_collision": false,
        "has_gravity": false
      },
      "minecraft:dimension_bound": {},
      "minecraft:renders_when_invisible": {},
      "minecraft:timer": {
        "time": 90,
        "looping": false,
        "time_down_event": {
          "event": "dm34:crack_timeout"
        }
      }
    },
    "component_groups": {
      "dm34:crack_gone": {
        "minecraft:instant_despawn": {}
      }
    },
    "events": {
      "dm34:crack_timeout": {
