{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "dm34:block_crack",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "dm34:crack_duration": {
          "type": "int",
          "range": [ 1, 1200 ],
          "default": 20,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:type_family": {
