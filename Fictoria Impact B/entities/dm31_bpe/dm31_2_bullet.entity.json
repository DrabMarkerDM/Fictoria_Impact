{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bullet:dm31_2_bullet",
      "runtime_identifier": "minecraft:snowball",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [
          "fire"
        ]
      },
      "animations": {
        "fire": "controller.animation.dm31fire"
      }
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuseLength": 0,
          "fuseLit": true,
          "power": 0.4,
          "causesFire": false,
          "fire_affected_by_griefing": true,
          "destroy_affected_by_griefing": true
        }
      },
      "despawning": {
        "minecraft:type_family": {
          "family": [
            "despawer",
            "despawer_despawning",
            "dm"
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "bullet", "inanimate", "dm" ]
      },
      "minecraft:collision_box": {
        "width": 0.1,
        "height": 0.1
      },
      "minecraft:variant": {
        "value": 1
      },
      "minecraft:timer": {
        "looping": true,
        "randomInterval": false,
        "time": 0.25,
        "time_down_event": {
          "event": "minecraft:start_despawn"
        }
      },
      "minecraft:spawn_entity": [
        {
          "min_wait_time": 0,
          "max_wait_time": 0,
          "single_use": true,
          "spawn_entity": "null:null",
          "spawn_sound": "fire",
          "num_to_spawn": 6
        }
      ],
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "self",
                  "value": "despawer_despawning"
                }
              ]
            }
          ]
        }
      },
       "minecraft:projectile": {
	     "onHit": {
	     "impact_damage": {
       "damage": 76,
	     "knockback": true,
	     "semirandomdiffdamage": false,
	     "destroyonhit": false
          }
        },
        "hit_sound": "gun.hit",
        "liquid_inertia": 1.8,
        "power": 1,
        "gravity": 0,
        "angleoffset": 0.0,
        "reflect_on_hurt": true,
        "anchor": 1,
        "offset": [ 0, -0.1, 0 ],
        "inertia": 1.8
      },
      "minecraft:physics": {
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 75000,
                "queue_command": {
                  "command": [
                    "particle dm:dm31_2 ^^1.5^2"
                  ]
                }
              },
              {
                "weight": 25000,
                "queue_command": {
                  "command": [
                    "scoreboard players remove @e[type=player:dm31,c=1] dm_skill_timer_1 1",
                    "playsound dm31_charge @a[r=42] ~~~ 1.8 1.0",
                    "particle dm:dm31_2 ^^1.5^2",
                    "particle dm:dm31_2 ^^1.5^2",
                    "effect @e[type=player:dm31,c=1] absorption 8 18 true",
                    "function dm31"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:explode": {
        "add": {
          "component_groups": [ "minecraft:exploding" ]
        }
      },
      "minecraft:start_despawn": {
        "add": {
          "component_groups": [ "despawning" ]
        }
      }
    }
  }
}
