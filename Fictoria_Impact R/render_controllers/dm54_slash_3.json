				{
					"*": "material.light"
				}
			],
			"is_hurt_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
            "on_fire_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
			"textures": [
				"temp.anim_time = query.anim_time * 16.0; return temp.anim_time < 8.0 ? array.frames[temp.anim_time] : Texture.empty;"
