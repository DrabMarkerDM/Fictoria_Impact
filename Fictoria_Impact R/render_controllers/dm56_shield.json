{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.dm56_shield": {
      "geometry": "Geometry.shield",
      "part_visibility": [
        { "*": "query.mark_variant == 2" }
      ],
      "materials": [ { "*": "Material.shield" } ],
      "is_hurt_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
      "on_fire_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
      "textures": [ "Texture.shield" ],
      "overlay_color": {
          "r": 1.0,
          "g": 1.0,
          "b": 1.0,
          "a": 1.0
      },
      "uv_anim": {
          "offset": [ "(query.mark_variant == 2) ? (Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01 : 0.0", 
                      "(query.mark_variant == 2) ? (Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01 : 0.0" ],
          "scale": [ 1.0, 1.0 ]
      },
      "light_color_multiplier": 0.5,
      "ignore_lighting" : true
    }
  }
}
