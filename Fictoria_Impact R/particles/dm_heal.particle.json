{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dm:dm_heal",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/dm_heal"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "30 + 50 * math.sin(v.emitter_age / 1.5 * 3.14159)",
        "max_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.5
      },
      "minecraft:emitter_shape_box": {
        "offset": [0, -0.2, 0],
        "half_dimensions": [0.4, 0.0, 0.4],
        "surface_only": true,
        "direction": ["math.random(-0.03,0.03)", 1.0, "math.random(-0.03,0.03)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.3, 2.2)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, "math.max(0, 8 * (1 - v.particle_age / (1.5 + v.particle_random_2 * 1.0)))", 0],
        "linear_drag_coefficient": "3 + v.particle_age * 1.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.20 + 0.28 * (v.particle_age / v.particle_lifetime)",
          "0.20 + 0.28 * (v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.15": "#00FFFFFF",
            "0.22": "#EDFFFFFF",
            "0.65": "#F200FFFE",
            "1.0": "#0000FFFF"
          }
        }
      }
    }
  }
}