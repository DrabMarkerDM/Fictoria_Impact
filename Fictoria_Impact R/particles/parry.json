{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecrafts:parry_particle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/parry"
      }
    },
    "curves": {
      "variable.hieseyo": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.3, 0.15, 0, 0]
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 20
      },
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_shape_sphere": {
        "radius": 0.01,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.6)"
      },
      "minecraft:particle_initial_speed": 8,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": "18 * math.max(0, 1 - v.particle_age / 0.2)",
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.015 + v.hieseyo",
          "v.particle_age > 0.04 ? 0.015"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 5,
          "texture_height": 5,
          "uv": [0, 0],
          "uv_size": [5, 5]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.3": "#FFFFD700",
            "0.7": "#FFFFA500",
            "1.0": "#00FFA500"
          }
        }
      }
    }
  }
}