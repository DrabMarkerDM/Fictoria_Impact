{
	"format_version" : "1.10.0",
	"animation_controllers": {
		"controller.animation.dm62att7": {
			"initial_state": "default",
			"states": {
				"attacking": {
					"animations": [ "att7" ],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"attacking": "variable.attack_time > 0.0 && query.mark_variant == 7"
						}
					]
				}
			}
		}
	}
}
