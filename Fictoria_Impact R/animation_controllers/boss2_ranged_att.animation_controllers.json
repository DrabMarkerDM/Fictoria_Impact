{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.boss2.ranged_att" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt" : {
					"animations" : [ "bow_and_arrow" ],
					"transitions" : [
						{
							"default" : "!query.has_target || query.get_equipped_item_name != 'boss2_2'"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"ratt" : "query.has_target && query.get_equipped_item_name == 'boss2_2'"
						}
          ]
        }
      }
    }
  }
}
