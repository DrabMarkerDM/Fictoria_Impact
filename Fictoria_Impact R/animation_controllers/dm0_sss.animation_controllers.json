{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.dm0_sss" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt" : {
					"animations" : [ "charging" ],
					"transitions" : [
						{
							"default" : "query.variant != 5 || !query.has_target"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"ratt" : "query.variant == 5 && query.has_target"
						}
          ]
        }
      }
    }
  }
}
