{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.dm8_ratt_target" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt" : {
					"animations" : [ "bow_and_arrow" ],
					"transitions" : [
						{
							"default": "!query.has_target || q.property('dm8:test') != 'ratt'"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"ratt": "query.has_target && q.property('dm8:test') == 'ratt'"
						}
          ]
        }
      }
    }
  }
}
