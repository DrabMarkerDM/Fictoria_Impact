{
  "namespace": "hud",

  "not_centered_gui_elements": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "regen_panel_non_centered": {
              "type": "panel",
              "offset": [2, 6.5],
              "size": ["0%c", "0%c"],
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "controls": [
                { "regen_factory_non_centered@java_regen.regen_factory_non_centered": {} }
              ],
              "bindings": [
                {
                  "binding_name": "#show_survival_ui",
                  "binding_name_override": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "regen_panel": {
              "type": "panel",
              "size": ["100%c", 9],
              "controls": [
                { "regen_factory@java_regen.regen_factory": {} }
              ]
            }
          }
        ]
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle_touch": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "regen_panel_clasic": {
              "type": "panel",
              "size": ["100%c", 9],
              "controls": [
                { "regen_factory_clasic@java_regen.regen_factory_clasic": {} }
              ]
            }
          }
        ]
      }
    ]
  },

  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "global",
          "binding_name": "#hud_title_text_string",
          "binding_name_override": "#title_check"
        }
      },
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "(not (('%.1s' * #title_check) = '!'))",
          "target_property_name": "#visible"
        }
      }
    ]
  },

  "hud_actionbar_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "(#text != '' and not (('%.1s' * #text) = '!'))",
          "target_property_name": "#visible"
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "coldown_element": {
              "type": "panel",
              "size": ["16px", "16px"],
              "controls": [
                { "cooldown_panel@javacombat.cooldown_panel": {} }
              ]
            }
          }
        ]
      }
    ]
  }
}