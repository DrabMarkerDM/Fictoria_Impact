{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dm:dust_particle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/parry"
      }
    },
    "curves": {
      "variable.dust_size": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.5, 1.0, 1.2, 0.0]
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 1.2,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.5)"
      },
      "minecraft:particle_initial_speed": "math.random(1.0, 2.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.4, 0],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 * variable.dust_size",
          "0.15 * variable.dust_size"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 10,
          "texture_height": 10,
          "uv": [0, 0],
          "uv_size": [10, 10]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.75",
          "0.7",
          "0.65",
          "math.max(0, 0.7 * (1 - v.particle_age / v.particle_lifetime))"
        ]
      }
    }
  }
}