{
	"format_version" : "1.10.0",
	"animation_controllers": {
		"controller.animation.dm61_sss": {
			"initial_state": "default",
			"states": {
				"attacking": {
					"animations": [ "sss" ],
					"transitions": [
						{
							"default": "variable.attack_time < 0.0 || query.variant != 2"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"attack": "variable.attack_time >= 0.0 && query.variant == 2"
						}
					]
				}
			}
		}
	}
}
