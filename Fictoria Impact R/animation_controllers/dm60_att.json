{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.dm60att": {
			"initial_state": "default",
			"states": {
				"bow": {
					"animations": [
						"bow_and_arrow"
					],
					"transitions": [
						{
							"default": "!query.has_target || query.get_equipped_item_name != 'dm60'"
						},
						{
							"att": "variable.attack_time > 0.0 && query.variant != 3 "
						},
						{
							"charge": "query.get_equipped_item_name == 'dm60_1'"
						},
						{
							"brand": "query.variant == 3 && variable.attack_time > 0.0"
						}
					]
				},
				"charge": {
					"animations": [
						"charging"
					],
					"transitions": [
						{
							"default": "!query.has_target || query.get_equipped_item_name != 'dm60_1'"
						},
						{
							"att": "variable.attack_time > 0.0 && query.variant != 3 "
						},
						{
							"bow": "query.get_equipped_item_name == 'dm60'"
						},
						{
							"brand": "query.variant == 3 && variable.attack_time > 0.0"
						}
					]
				},
				"brand": {
					"animations": [
						"brandish_spear"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				},
				"att": {
					"animations": [
						"attack.rotations"
					],
					"transitions": [
						{
							"bow": "query.has_target && variable.attack_time <= 0.0 && query.get_equipped_item_name == 'dm60'"
						},
						{
							"default": "variable.attack_time <= 0.0 || query.variant == 3 "
						},
						{
							"charge": "query.has_target && variable.attack_time <= 0.0 && query.get_equipped_item_name == 'dm60_1'"
						},
						{
							"brand": "query.variant == 3 && variable.attack_time > 0.0"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"bow": "query.has_target && variable.attack_time <= 0.0 && query.get_equipped_item_name == 'dm60'"
						},
						{
							"att": "variable.attack_time > 0.0 && query.variant != 3 "
						},
						{
							"charge": "query.has_target && variable.attack_time <= 0.0 && query.get_equipped_item_name == 'dm60_1'"
						},
						{
							"brand": "query.variant == 3 && variable.attack_time > 0.0"

						}
					]
				}
			}    
		}
	}
}