{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.ori_ratt" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt" : {
					"animations": [ "attack.rotations" ],
					"transitions" : [
						{
							"default": "query.get_equipped_item_name != 'Original_sword' || query.item_remaining_use_duration <= 0"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"ratt": "query.get_equipped_item_name == 'Original_sword' && query.item_remaining_use_duration > 0"
						}
          ]
        }
      }
    }
  }
}
