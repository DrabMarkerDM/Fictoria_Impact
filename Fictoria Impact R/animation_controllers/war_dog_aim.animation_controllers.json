{
  "format_version": "1.21.50",
  "animation_controllers": {
    "controller.animation.war_dog_aim": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "leap_attack": "query.has_target && query.variant == 2"
            }
          ]
        },
        "leap_attack": {
          "animations": ["aim"],
          "transitions": [
            {
              "default": "!query.has_target || query.variant != 2"
           }
					],
					"blend_transition": 0.25
        }
      }
    }
  }
}