{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dm_slash_s2": {
      "initial_state": "hidden",
      "states": {
        "hidden": {
          "transitions": [
            { "playing": "query.property('dm:is_attacking_4') == 'on'" }
          ]
        },
        "playing": {
          "animations": [ "slash_s2" ], 
          "transitions": [
            { "hidden": "query.any_animation_finished" }
          ]
        }
      }
    }
  }
}