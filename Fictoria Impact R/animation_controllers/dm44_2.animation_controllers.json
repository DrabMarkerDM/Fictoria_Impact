{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.dm44_2" : {
			"initial_state" : "default",
			"states" : {
				"attacking" : {
					"animations": [ "attack.rotations" ],
					"transitions" : [
						{
							"default": "variable.attack_time < 0.0 || query.variant == 3"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"attacking": "variable.attack_time >= 0.0 && query.variant != 3"
						}
          ]
        }
      }
    }
  }
}
