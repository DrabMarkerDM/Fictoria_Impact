{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.dm_riding": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"riding": "query.is_riding"
						}
					]
				},
				"riding": {
					"animations": [ "riding" ],
					"transitions": [
						{
							"default": "!query.is_riding"
						}
					]
				}
			}
		}
	}
}