{
	"format_version" : "1.10.0",
	"animation_controllers": {
		"controller.animation.dm62att4": {
			"initial_state": "default",
			"states": {
				"attacking": {
					"animations": [ "att4" ],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"attacking": "query.is_delayed_attacking && query.mark_variant == 4"
						}
					]
				}
			}
		}
	}
}
