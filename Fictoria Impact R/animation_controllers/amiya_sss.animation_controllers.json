{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.amiya_sss" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt" : {
					"animations" : [ "sss" ],
					"transitions" : [
						{
							"default" : "!query.has_target || !query.property('dm:dm26_sss')"
						}
					]
				},
				"default" : {
					"transitions" : [
						{
							"ratt" : "query.has_target && query.property('dm:dm26_sss')"
						}
          ]
        }
      }
    }
  }
}
