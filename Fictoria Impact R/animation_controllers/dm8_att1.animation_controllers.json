{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.dm8_att1" : {
		             			"initial_state" : "default",
			"states" : {
				"ratt": {
					"animations": [ "attack.rotations" ],
					"transitions": [
						{
							"default": "query.variant != 1 || variable.attack_time <= 0.0"
						}
					],
					"blend_transition": 0.1
				},
				"default": {
					"transitions": [
						{
							"ratt": "query.variant == 1 && variable.attack_time > 0.0"
						}
					]
				}
      }
    }
  }
}
