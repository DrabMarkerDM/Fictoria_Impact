{
	"format_version": "1.8.0",
	"animations": {
		// 三段式：hold 待机持矛 / use 蓄力 / attack 戳刺。
		//
		// **谁在播**（2026-11-12 定案）：
		//   hold / use   由 controller.animation.dm34_spear 常驻（按 query.variant == 8）。
		//   attack       **只能由 JS 播**。控制器只在"状态切换"时起播，
		//                它靠 variable.attack_time 进出 attack 态，而那玩意在 mob 上
		//                不是每次攻击都归零 —— 上一轮还没归零就又打了下一轮，
		//                状态压根没离开过 attack，动画自然不重播。
		//                实测观感就是"打好几下才播一次""走路时完全不播"。
		//                melee_manager.js 在她每次命中时 playAnimation 一遍，一发一次。
		//
		// **override 的分层**（关键，别乱加）：
		//   hold / use **不写** override_previous_animation —— 它们是底层姿势，
		//   要能被 humanoid.move（走路摆臂）正常混合，也要能被上面的戳刺压住。
		//   attack 写 override_previous_animation: true —— 戳刺是覆盖层，
		//   不管底下叠着走路、持矛还是别的什么，0.4 秒内右臂必须按这里的曲线走。
		//   （旧版给 hold 也加了 override，结果 hold 每帧都在抢右臂，
		//     戳刺被压在下面露不出来，这就是"不播"的另一半原因。）
		//
		// **幅度**（2026-11-15 用户："整只右手臂都脱臼快向后飞出去，是位移太大"）：
		//   病灶在 `position`，不在 `rotation` —— 原位移后仰 -4、前刺 +11 像素，
		//   11 像素约 0.69 格，等于把整条手臂从肩关节**抽**出去，看起来就是脱臼。
		//   现在位移压到后仰 -1 / 前刺 +4 像素（≈0.25 格），旋转保留原曲线
		//   （-15 → -68 → +30 → +18 → -15），戳刺的"甩"感不变。
		//   原版 attack 只做旋转、手臂不前后动，看着像"原地抖手"；
		//   这里给 rightArm 加 z 轴位移（模型正面朝 +Z，+z 就是向前），是真往前捅。
		//   左臂反向配重，幅度比右臂小一半，不抢主体动作。
		//   收尾帧刻意等于 hold 的角度与位移（-15° / 0,0,0），播完无缝接回持矛姿势。
		"animation.dm34_spear_hold": {
			"loop": true,
			"bones": {
				"rightArm": {
					"rotation": [ -15.0, 0.0, 0.0 ],
					"position": [ 0.0, 0.0, 0.0 ]
				}
			}
		},
		"animation.dm34_spear_use": {
			"loop": true,
			"bones": {
				"rightArm": {
					"rotation": [ -30.0, 0.0, 0.0 ],
					"position": [ 0.0, 0.0, 0.0 ]
				}
			}
		},
		// 0.4 秒一轮，配 melee_box_attack 的 cooldown_time 0.6 秒：
		// 留 0.2 秒间隙，不会两个动作首尾相接糊成一团，也不至于"打完僵在那儿"。
		"animation.dm34_spear_attack": {
			"loop": false,
			"animation_length": 0.4,
			"override_previous_animation": true,
			"bones": {
				"rightArm": {
					"rotation": {
						"0.0": [ -15.0, 0.0, 0.0 ],
						"0.05": [ -68.0, 0.0, 0.0 ],
						"0.14": [ 30.0, 0.0, 0.0 ],
						"0.22": [ 18.0, 0.0, 0.0 ],
						"0.4": [ -15.0, 0.0, 0.0 ]
					},
					"position": {
						"0.0": [ 0.0, 0.0, 0.0 ],
						"0.05": [ 0.0, 0.8, -1.0 ],
						"0.14": [ 0.0, -0.8, 4.0 ],
						"0.22": [ 0.0, -0.5, 2.5 ],
						"0.4": [ 0.0, 0.0, 0.0 ]
					}
				},
				// 左臂反向摆动做配重（长矛是双手武器，左手跟着走才不像单手甩棍）
				"leftArm": {
					"rotation": {
						"0.0": [ 0.0, 0.0, 0.0 ],
						"0.05": [ 24.0, 0.0, 0.0 ],
						"0.14": [ -34.0, 0.0, 0.0 ],
						"0.22": [ -20.0, 0.0, 0.0 ],
						"0.4": [ 0.0, 0.0, 0.0 ]
					}
				}
			}
		}
	}
}
