{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.dm54_slash_1": {
			"arrays": {
				"textures": {
				  "array.frames": [
					"texture.a1",
					"texture.a2",
					"texture.a3",
					"texture.a4",
					"texture.a5",
					"texture.a6",
					"texture.a7",
					"texture.a8"

					]
				}
			},
			"geometry": "geometry.slash",
			"part_visibility": [
  { "*": true },
  { "slash_main": "query.property('dm:is_attacking_1') == 'on'" },
  { "slash_minor": "query.property('dm:is_attacking_3') == 'on'" }
      ],
			"materials": [
				{
					"*": "material.light"
				}
			],
			"is_hurt_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
            "on_fire_color": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0 },
			"textures": [
				"temp.anim_time = query.anim_time * 16.0; return temp.anim_time < 8.0 ? array.frames[temp.anim_time] : Texture.empty;"
			]
		}
	}
}