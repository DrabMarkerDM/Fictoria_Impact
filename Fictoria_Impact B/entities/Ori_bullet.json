{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bullet:ori_bullet",
      "runtime_identifier": "minecraft:snowball",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuseLength": 0,
          "fuseLit": true,
          "power": 0.5,
          "causesFire": false,
          "fire_affected_by_griefing": true,
          "destroy_affected_by_griefing": true
        }
      },
      "despawning": {
        "minecraft:type_family": {
          "family": [
            "despawer",
            "despawer_despawning",
            "dm"
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "bullet", "inanimate", "dm" ]
      },
      "minecraft:collision_box": {
        "width": 2.0,
        "height": 0.1
      },
      "minecraft:timer": {
        "looping": true,
        "randomInterval": false,
        "time": 0.25,
        "time_down_event": {
          "event": "minecraft:start_despawn"
        }
      },
      "minecraft:despawn": {
        "filters": {
          "all_of": [
            {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "self",
                  "value": "despawer_despawning"
                }
              ]
            }
          ]
        }
      },
      "minecraft:projectile": {
        "onHit": {
          "impact_damage": {
            "damage": 18,
            "knockback": true,
            "semirandomdiffdamage": false,
            "destroyonhit": false
          },
          "definition_event": {
            "affectProjectile": false,
            "eventTrigger": {
              "event": "buff",
              "target": "self"
            }
          }
        },
        "liquid_inertia": 1.8,
        "power": 1,
        "gravity": 0,
        "stop_on_hurt": false,
        "multiple_targets": true,
        "uncertaintyBase": 24,
        "uncertaintyMultiplier": 14,
        "angleoffset": 0.0,
        "reflect_on_hurt": true,
        "anchor": 1,
        "offset": [ 0, -1.4, 0 ],
        "inertia": 1.8,
        "catch_fire": false
      },
      "minecraft:physics": {
      }
    },
    "events": {
      "minecraft:explode": {
        "add": {
          "component_groups": [ "minecraft:exploding" ]
        }
      },
      "minecraft:start_despawn": {
        "add": {
          "component_groups": [ "despawning" ]
        }
      },
      "buff": {
        "queue_command": {
          "command": [
            "damage @e[tag=!dm,family=monster,r=18] 18 entity_attack entity @s",
            "effect @e[tag=dm,r=18,family=!monster] absorption 5 50 true",
            "effect @e[tag=dm,r=18,family=!monster] instant_health 5 1 true",
            "effect @a[r=12,c=6] strength 6 2 true",
            "effect @e[tag=dm,r=12,family=!monster,family=!inanimate,family=!mon3tr] strength 5 1 true"



          ]
        }
      }
    }
  }
}