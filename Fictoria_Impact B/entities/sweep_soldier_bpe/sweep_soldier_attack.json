        "mob_effect": {
          "effect": "wither",
          "durationeasy": 40,
          "durationnormal": 40,
          "durationhard": 40,
          "amplifier": 4
          },
          "remove_on_hit": { 
          }
        },
        "liquid_inertia": 1.8,
        "power": 1,
        "gravity": 0.05,
        "angleoffset": 0.0,
        "reflect_on_hurt": true,
        "anchor": 1,
        "uncertaintyBase": 10,
        "uncertaintyMultiplier": 5,
